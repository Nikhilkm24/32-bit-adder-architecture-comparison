# Formal verification script for 32-bit adders using Yosys SAT solver
# Mathematically proves that each adder's output {Cout, Sum} identically
# matches the golden arithmetic reference (A + B + Cin) for ALL 2^65 possible input states.

# --- 1. Formal Verification: Ripple-Carry Adder ---
read_verilog -sv rtl/ripple_carry_32.v
prep -top ripple_carry_32
opt_clean
rename ripple_carry_32 uut_rca
design -stash uut_rca

# Golden reference circuit
read_verilog -sv <<EOT
module golden_ref (
    input  wire [31:0] A,
    input  wire [31:0] B,
    input  wire        Cin,
    output wire [31:0] Sum,
    output wire        Cout
);
    assign {Cout, Sum} = {1'b0, A} + {1'b0, B} + Cin;
endmodule
EOT
prep -top golden_ref
opt_clean
rename golden_ref golden
design -stash golden

# --- Prove Ripple-Carry Adder Equivalence ---
design -copy-from uut_rca -as uut uut_rca
design -copy-from golden -as ref golden
miter -equiv -flatten -make_assert ref uut miter_rca
prep -top miter_rca
sat -verify -prove-asserts -show-all
design -reset

